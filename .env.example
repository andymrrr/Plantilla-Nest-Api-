# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nest_template

# TypeORM
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Aplicación (branding en correos)
APP_NAME=Mi Aplicación
APP_PUBLIC_URL=http://localhost:3001

# SMTP — módulo mail (MailService)
# En desarrollo sin servidor: MAIL_LOG_ONLY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_LOG_ONLY=true

# OTP — verificación registro
AUTH_REGISTER_EMAIL_OTP_TTL_SECONDS=600
AUTH_REGISTER_EMAIL_OTP_RESEND_SECONDS=60
AUTH_REGISTER_EMAIL_OTP_MAX_ATTEMPTS=5
AUTH_REGISTER_EMAIL_OTP_PEPPER=cambia-este-pepper-en-produccion

# OTP — login 2FA
AUTH_LOGIN_2FA_OTP_TTL_SECONDS=600
AUTH_LOGIN_2FA_MAX_ATTEMPTS=5
AUTH_LOGIN_2FA_OTP_PEPPER=cambia-este-pepper-2fa-en-produccion

# PayPal — suscripciones SaaS
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Seed — planes SaaS (TypeORM upsert, sin SQL directo)
SEED_ON_STARTUP=false
SEED_ENDPOINT_ENABLED=false
SEED_PLATFORM_PLAN_STARTER_PAYPAL_PLAN_ID=
SEED_PLATFORM_PLAN_PROFESSIONAL_PAYPAL_PLAN_ID=
SEED_PLATFORM_PLAN_ENTERPRISE_PAYPAL_PLAN_ID=
SEED_PLATFORM_PLAN_STARTER_PRICE_CENTS=1900
SEED_PLATFORM_PLAN_PROFESSIONAL_PRICE_CENTS=4900
SEED_PLATFORM_PLAN_ENTERPRISE_PRICE_CENTS=9900
